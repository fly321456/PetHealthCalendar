page {
  min-height: 100%;
  background: #f7f8f4;
  color: #1f2d28;
  font-family: Manrope, -apple-system, BlinkMacSystemFont, "PingFang SC", "Segoe UI", sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input,
textarea,
picker {
  box-sizing: border-box;
}

button {
  padding: 0 28rpx;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 36rpx 32rpx calc(72rpx + env(safe-area-inset-bottom));
}

.section {
  margin-top: 24rpx;
}

.panel {
  padding: 28rpx;
  border: 1rpx solid #dce4d8;
  border-radius: 12rpx;
  background: #ffffff;
}

.focus-panel {
  border-color: #c7d9cf;
  box-shadow: 0 10rpx 28rpx rgba(47, 111, 94, 0.07);
}

.soft-panel {
  padding: 24rpx;
  border: 1rpx solid #dce4d8;
  border-radius: 12rpx;
  background: #eef5ef;
}

.page-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.header-copy {
  min-width: 0;
}

.eyebrow {
  margin-bottom: 10rpx;
  color: #2f6f5e;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.2;
}

.muted {
  color: #758078;
}

.tiny {
  font-size: 24rpx;
  line-height: 1.45;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 0;
  line-height: 1.2;
}

.block-title,
.section-title {
  color: #1f2d28;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.25;
}

.subtitle {
  margin-top: 8rpx;
  color: #758078;
  line-height: 1.5;
}

.primary-btn,
.ghost-btn,
.danger-btn {
  width: 100%;
  min-height: 88rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 88rpx;
  font-weight: 600;
}

.primary-btn {
  color: #ffffff;
  background: #2f6f5e;
}

.ghost-btn {
  color: #2f6f5e;
  border: 1rpx solid #b8c8bf;
  background: #eef5ef;
}

.danger-btn {
  color: #a23e36;
  border: 1rpx solid #e0b9b5;
  background: #fff7f6;
}

.btn-press {
  opacity: 0.82;
}

.card-press,
.chip-press {
  opacity: 0.86;
}

button[disabled] {
  color: rgba(255, 255, 255, 0.86) !important;
  background: #a8b8b0 !important;
}

.ghost-btn[disabled] {
  color: #758078 !important;
  border-color: #dce4d8 !important;
  background: #eef1ec !important;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  min-height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #2f6f5e;
  background: #e6f2ed;
  font-size: 24rpx;
  font-weight: 600;
}

.tag.warn {
  color: #9a5a12;
  background: #fff2d9;
}

.tag.danger {
  color: #a23e36;
  background: #ffe5e2;
}

.field {
  margin-top: 24rpx;
}

.field:first-child {
  margin-top: 0;
}

.label {
  margin-bottom: 12rpx;
  color: #3f4e47;
  font-size: 26rpx;
  font-weight: 600;
}

.input,
.textarea,
.select {
  width: 100%;
  min-height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid #dce4d8;
  border-radius: 12rpx;
  background: #ffffff;
  color: #1f2d28;
  line-height: 88rpx;
}

.textarea {
  min-height: 160rpx;
  padding-top: 20rpx;
  line-height: 1.5;
}

.select-action {
  color: #2f6f5e;
  font-size: 24rpx;
  font-weight: 700;
}

.helper {
  margin-top: 10rpx;
  color: #758078;
  font-size: 24rpx;
  line-height: 1.45;
}

.error-text {
  margin-top: 10rpx;
  color: #a23e36;
  font-size: 24rpx;
  line-height: 1.45;
}

.field.has-error .input,
.field.has-error .textarea,
.field.has-error .select {
  border-color: #d98d86;
  background: #fffafa;
}

.empty {
  padding: 56rpx 24rpx;
  text-align: center;
  color: #7a8175;
}

.empty-title {
  color: #1f2d28;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.25;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.medical-note {
  margin-top: 28rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #e3e0c9;
  border-radius: 12rpx;
  color: #6e6a48;
  background: #fffdf0;
  font-size: 24rpx;
  line-height: 1.6;
}

.summary-grid {
  display: flex;
  gap: 12rpx;
}

.summary-cell {
  flex: 1;
  min-width: 0;
  padding: 18rpx 16rpx;
  border: 1rpx solid #dce4d8;
  border-radius: 12rpx;
  background: #ffffff;
}

.summary-value {
  color: #1f2d28;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.1;
}

.summary-label {
  margin-top: 8rpx;
  color: #758078;
  font-size: 22rpx;
  line-height: 1.35;
}
