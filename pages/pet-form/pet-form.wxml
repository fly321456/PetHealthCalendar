<view class="page">
  <view class="page-header">
    <view class="header-copy">
      <view class="eyebrow">宠物档案</view>
      <view class="title">添加宠物</view>
      <view class="subtitle">先保存基础信息，健康日期之后都可以修改。</view>
    </view>
  </view>

  <view class="panel section">
    <view class="block-title">基础信息</view>
    <view class="subtitle">用于生成这只宠物的提醒日历。</view>

    <view class="field">
      <view class="label">宠物类型</view>
      <radio-group class="type-row" bindchange="onTypeChange">
        <label class="type-option {{form.type === 'cat' ? 'active' : ''}}">
          <radio value="cat" checked="{{form.type === 'cat'}}" />
          <view class="type-copy">
            <view class="type-title">猫</view>
            <view class="tiny muted">猫咪档案</view>
          </view>
        </label>
        <label class="type-option {{form.type === 'dog' ? 'active' : ''}}">
          <radio value="dog" checked="{{form.type === 'dog'}}" />
          <view class="type-copy">
            <view class="type-title">狗</view>
            <view class="tiny muted">狗狗档案</view>
          </view>
        </label>
      </radio-group>
    </view>

    <view class="field {{errors.name ? 'has-error' : ''}}">
      <view class="label">宠物名 *</view>
      <input class="input" placeholder="例如：糯米" value="{{form.name}}" data-field="name" bindinput="onInput" />
      <view wx:if="{{errors.name}}" class="error-text">{{errors.name}}</view>
    </view>

    <view class="field">
      <view class="label">生日或年龄</view>
      <input class="input" placeholder="例如：2025-08 或 8个月" value="{{form.ageText}}" data-field="ageText" bindinput="onInput" />
      <view class="helper">不知道精确生日时，写大概年龄即可。</view>
    </view>
  </view>

  <view class="panel section">
    <view class="block-title">历史日期</view>
    <view class="subtitle">不知道就跳过，系统会标记为待确认。</view>

    <view class="field">
      <view class="label">最近一次疫苗日期</view>
      <picker mode="date" value="{{form.vaccineDate}}" data-field="vaccineDate" bindchange="onDateChange">
        <view class="select">
          <text>{{form.vaccineDate || '不知道，先跳过'}}</text>
          <text class="select-action">选择</text>
        </view>
      </picker>
      <view class="helper">疫苗提醒不自动判断接种方案，请按医生建议修改下一次日期。</view>
    </view>

    <view class="field">
      <view class="label">最近一次体内驱虫</view>
      <picker mode="date" value="{{form.internalDewormDate}}" data-field="internalDewormDate" bindchange="onDateChange">
        <view class="select">
          <text>{{form.internalDewormDate || '不知道，先跳过'}}</text>
          <text class="select-action">选择</text>
        </view>
      </picker>
      <view class="helper">填写后会按默认 90 天生成下一次提醒。</view>
    </view>

    <view class="field">
      <view class="label">最近一次体外驱虫</view>
      <picker mode="date" value="{{form.externalDewormDate}}" data-field="externalDewormDate" bindchange="onDateChange">
        <view class="select">
          <text>{{form.externalDewormDate || '不知道，先跳过'}}</text>
          <text class="select-action">选择</text>
        </view>
      </picker>
      <view class="helper">填写后会按默认 30 天生成下一次提醒。</view>
    </view>
  </view>

  <button class="primary-btn section" hover-class="btn-press" loading="{{saving}}" disabled="{{saving}}" bindtap="save">{{saving ? '正在生成' : '保存并生成日历'}}</button>
  <view class="medical-note">仅作日程提醒和历史记录，具体方案请以宠物医生建议为准。</view>
</view>
