.type-row {
  display: flex;
  gap: 16rpx;
}

.type-option {
  display: flex;
  flex: 1;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  min-height: 96rpx;
  padding: 16rpx;
  border: 1rpx solid #dce4d8;
  border-radius: 12rpx;
  background: #ffffff;
  font-weight: 600;
}

.type-option.active {
  color: #2f6f5e;
  border-color: #2f6f5e;
  background: #e6f2ed;
}

.type-copy {
  min-width: 0;
}

.type-title {
  color: #1f2d28;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.3;
}

.select {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  color: #3f4e47;
}
