.type-row {
  display: flex;
  gap: 18rpx;
}

.type-option {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 180rpx;
  height: 88rpx;
  border: 1rpx solid #dce4d8;
  border-radius: 12rpx;
  background: #ffffff;
  font-weight: 600;
}

.type-option.active {
  color: #2f6f5e;
  border-color: #2f6f5e;
  background: #e6f2ed;
}

.block-title {
  color: #1f2d28;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.25;
}

.select {
  display: flex;
  align-items: center;
  color: #3f4e47;
}
