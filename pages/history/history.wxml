<view class="page">
  <view class="page-header">
    <view class="header-copy">
      <view class="eyebrow">健康档案</view>
      <view class="title">历史记录</view>
      <view class="subtitle">疫苗、驱虫、体检完成后都会留在这里。</view>
    </view>
  </view>

  <view wx:if="{{!records.length}}" class="panel section">
    <view class="empty">
      <view class="empty-title">还没有完成记录</view>
      <view class="subtitle">从日历页标记一次待办后，这里会自动更新。</view>
    </view>
  </view>

  <block wx:else>
    <view class="summary-grid section">
      <view wx:for="{{summary}}" wx:key="label" class="summary-cell">
        <view class="summary-value">{{item.value}}</view>
        <view class="summary-label">{{item.label}}</view>
        <view class="summary-helper">{{item.helper}}</view>
      </view>
    </view>

    <view class="timeline section">
      <view wx:for="{{records}}" wx:key="id" class="record-item">
        <view class="time-badge">
          <view class="date-short">{{item.completedShort}}</view>
          <view class="tiny muted">完成</view>
        </view>
        <view class="record-copy">
          <view class="row record-head">
            <view class="item-title">{{item.title}}</view>
            <view class="tag">已完成</view>
          </view>
          <view class="muted tiny">{{item.petName}} · {{item.completedDate}}</view>
          <view wx:if="{{item.nextDueDate}}" class="next">下次提醒：{{item.nextDueDate}}</view>
          <view wx:if="{{item.note}}" class="note">{{item.note}}</view>
        </view>
      </view>
    </view>
  </block>
</view>
