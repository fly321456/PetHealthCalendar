<view class="page">
  <view class="title">历史记录</view>
  <view class="subtitle">疫苗、驱虫、体检完成后都会留在这里。</view>

  <view wx:if="{{!records.length}}" class="panel section">
    <view class="empty">
      <view class="empty-title">还没有完成记录</view>
      <view class="subtitle">从日历页标记一次待办后，这里会自动更新。</view>
    </view>
  </view>

  <view wx:else class="list section">
    <view wx:for="{{records}}" wx:key="id" class="record-item">
      <view class="row">
        <view class="item-title">{{item.title}}</view>
        <view class="muted tiny">{{item.completedDate}}</view>
      </view>
      <view class="muted">{{item.petName}}</view>
      <view wx:if="{{item.nextDueDate}}" class="next">下次提醒：{{item.nextDueDate}}</view>
      <view wx:if="{{item.note}}" class="note">{{item.note}}</view>
    </view>
  </view>
</view>
