.empty-title {
  color: #1f2d28;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.25;
}

.record-item {
  padding: 24rpx;
  border: 1rpx solid #dce4d8;
  border-radius: 12rpx;
  background: #ffffff;
}

.item-title {
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.next {
  margin-top: 14rpx;
  color: #2f6f5e;
  font-size: 24rpx;
  font-weight: 600;
}

.note {
  margin-top: 14rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  color: #3f4e47;
  background: #f0f4ee;
  font-size: 24rpx;
  line-height: 1.5;
}
