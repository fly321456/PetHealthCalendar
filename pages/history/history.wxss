.timeline {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.record-item {
  display: flex;
  gap: 18rpx;
  padding: 24rpx;
  border: 1rpx solid #dce4d8;
  border-radius: 12rpx;
  background: #ffffff;
}

.time-badge {
  display: flex;
  flex: 0 0 108rpx;
  flex-direction: column;
  justify-content: center;
  min-width: 108rpx;
  padding: 14rpx 12rpx;
  border-radius: 12rpx;
  background: #eef5ef;
  text-align: center;
}

.date-short {
  color: #1f2d28;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.2;
}

.record-copy {
  flex: 1;
  min-width: 0;
}

.record-head {
  align-items: flex-start;
}

.item-title {
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.next {
  margin-top: 14rpx;
  color: #2f6f5e;
  font-size: 24rpx;
  font-weight: 600;
}

.note {
  margin-top: 14rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  color: #3f4e47;
  background: #f0f4ee;
  font-size: 24rpx;
  line-height: 1.5;
}

.summary-helper {
  margin-top: 4rpx;
  color: #758078;
  font-size: 20rpx;
  line-height: 1.3;
}
