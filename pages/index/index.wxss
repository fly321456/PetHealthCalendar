.hero {
  padding-bottom: 4rpx;
}

.add-btn {
  width: 136rpx;
  flex: 0 0 136rpx;
}

.pet-tabs {
  width: 100%;
  white-space: nowrap;
}

.pet-chip {
  display: inline-flex;
  align-items: center;
  min-width: 112rpx;
  height: 68rpx;
  margin-right: 14rpx;
  padding: 0 26rpx;
  border: 1rpx solid #dce4d8;
  border-radius: 999rpx;
  color: #3f4e47;
  background: #ffffff;
  font-weight: 600;
}

.pet-chip.active {
  color: #ffffff;
  border-color: #2f6f5e;
  background: #2f6f5e;
}

.focus-card {
  background: #fafffc;
  padding: 30rpx;
}

.focus-top {
  align-items: flex-start;
}

.focus-label {
  color: #758078;
  font-size: 24rpx;
  font-weight: 600;
}

.focus-pet {
  margin-top: 6rpx;
  color: #2f6f5e;
  font-size: 26rpx;
  font-weight: 700;
}

.focus-title {
  margin-top: 22rpx;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.2;
}

.focus-meta {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  margin-top: 20rpx;
}

.date-block,
.item-date {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 104rpx;
  padding: 12rpx 14rpx;
  border: 1rpx solid #dce4d8;
  border-radius: 12rpx;
  background: #eef5ef;
}

.focus-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  justify-content: center;
}

.date-short {
  color: #1f2d28;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.2;
}

.countdown {
  color: #1f2d28;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.35;
}

.notice {
  margin-top: 18rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  color: #7a5613;
  background: #fff4dc;
  font-size: 24rpx;
  line-height: 1.45;
}

.card-cta {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #dce4d8;
  color: #2f6f5e;
  font-size: 26rpx;
  font-weight: 700;
}

.summary-helper {
  margin-top: 4rpx;
  color: #758078;
  font-size: 20rpx;
  line-height: 1.3;
}

.section-head {
  align-items: flex-end;
}

.small-btn {
  width: 120rpx;
  min-height: 64rpx;
  line-height: 64rpx;
}

.reminder-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx;
  border: 1rpx solid #dce4d8;
  border-radius: 12rpx;
  background: #ffffff;
}

.item-copy {
  flex: 1;
  min-width: 0;
}

.item-title {
  margin-bottom: 8rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.compact-empty {
  padding-top: 40rpx;
  padding-bottom: 40rpx;
}
