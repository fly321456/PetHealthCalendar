<view class="page">
  <view class="page-header">
    <view class="header-copy">
      <view class="eyebrow">宠物档案</view>
      <view class="title">我的宠物</view>
      <view class="subtitle">管理宠物档案和健康日历。</view>
    </view>
    <button class="ghost-btn add-btn" hover-class="btn-press" bindtap="goAdd">添加</button>
  </view>

  <view wx:if="{{!pets.length}}" class="panel section">
    <view class="empty">
      <view class="empty-title">还没有宠物档案</view>
      <view class="subtitle">添加后会自动生成健康提醒。</view>
      <button class="primary-btn section" hover-class="btn-press" bindtap="goAdd">添加宠物</button>
    </view>
  </view>

  <block wx:else>
    <view class="summary-grid section">
      <view wx:for="{{summary}}" wx:key="label" class="summary-cell">
        <view class="summary-value">{{item.value}}</view>
        <view class="summary-label">{{item.label}}</view>
        <view class="summary-helper">{{item.helper}}</view>
      </view>
    </view>

    <view class="list section">
      <view wx:for="{{pets}}" wx:key="id" class="pet-card">
        <view class="pet-avatar">{{item.typeText}}</view>
        <view class="pet-info">
          <view class="pet-name">{{item.name}}</view>
          <view class="muted tiny">{{item.ageText}}</view>
        </view>
        <view class="pet-type tag">{{item.typeText}}</view>
      </view>
    </view>
  </block>
</view>
