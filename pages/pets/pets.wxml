<view class="page">
  <view class="row">
    <view class="header-copy">
      <view class="title">我的宠物</view>
      <view class="subtitle">管理宠物档案和健康日历。</view>
    </view>
    <button class="ghost-btn add-btn" hover-class="btn-press" bindtap="goAdd">添加</button>
  </view>

  <view wx:if="{{!pets.length}}" class="panel section">
    <view class="empty">
      <view class="empty-title">还没有宠物档案</view>
      <view class="subtitle">添加后会自动生成健康提醒。</view>
      <button class="primary-btn section" hover-class="btn-press" bindtap="goAdd">添加宠物</button>
    </view>
  </view>

  <view wx:else class="list section">
    <view wx:for="{{pets}}" wx:key="id" class="pet-card">
      <view class="pet-avatar">{{item.type === 'cat' ? '猫' : '狗'}}</view>
      <view class="pet-info">
        <view class="pet-name">{{item.name}}</view>
        <view class="muted tiny">{{item.ageText || '年龄未填写'}}</view>
      </view>
    </view>
  </view>
</view>
