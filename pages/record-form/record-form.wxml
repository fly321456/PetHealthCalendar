<view class="page">
  <view wx:if="{{reminder}}">
    <view class="title">完成记录</view>
    <view class="subtitle">{{reminder.petName}} · {{reminder.title}}</view>

    <view class="panel section">
      <view class="field">
        <view class="label">完成日期</view>
        <picker mode="date" value="{{form.completedDate}}" data-field="completedDate" bindchange="onDateChange">
          <view class="select">{{form.completedDate}}</view>
        </picker>
      </view>

      <view class="field">
        <view class="label">下次提醒日期</view>
        <picker mode="date" value="{{form.nextDueDate}}" data-field="nextDueDate" bindchange="onDateChange">
          <view class="select">{{form.nextDueDate || '不生成下次提醒'}}</view>
        </picker>
        <view class="helper">系统按默认周期生成，你可以按医生建议修改。</view>
      </view>

      <view class="field">
        <view class="label">备注</view>
        <textarea class="textarea" placeholder="例如：宠物医院、医生建议、注意事项" value="{{form.note}}" bindinput="onNoteInput" />
      </view>
    </view>

    <button class="primary-btn section" hover-class="btn-press" loading="{{saving}}" disabled="{{saving}}" bindtap="save">{{saving ? '保存中' : '保存记录'}}</button>
    <view class="medical-note">记录只用于日程和历史留档，不替代兽医建议。</view>
  </view>

  <view wx:else class="panel">
    <view class="empty">没有找到这条待办。</view>
  </view>
</view>
